# ====================
# KAFKA CONFIGURATION
# ====================
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
ORGANIZATION_ID=org-001

# ====================
# EMAIL CONFIGURATION (SMTP)
# ====================

# SMTP Server (Gmail example)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# SMTP Credentials
# IMPORTANTE: Para Gmail, usa una "Contraseña de aplicación", NO tu contraseña normal
SMTP_USER=nromerotz@gmail.com
SMTP_PASSWORD=tu-password-de-aplicacion

# Email Settings
FROM_EMAIL=nromerotz@gmail.com
FROM_NAME=Empuje Comunitario

# Debug Mode
# true = No envía emails reales, solo loguea en consola
# false = Envía emails reales por SMTP
EMAIL_DEBUG_MODE=true


# ========================================================================
# GUÍA PARA CONFIGURAR GMAIL
# ========================================================================
#
# 1. Ir a: https://myaccount.google.com/security
# 2. Activar "Verificación en 2 pasos"
# 3. Buscar "Contraseñas de aplicaciones"
# 4. Crear una nueva para "Correo"
# 5. Copiar la contraseña generada (16 caracteres sin espacios)
# 6. Pegarla en SMTP_PASSWORD
# 7. Cambiar EMAIL_DEBUG_MODE=false para enviar emails reales
#
# ========================================================================